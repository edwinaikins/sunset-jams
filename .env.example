# Postgres connection string (Vercel Postgres / Neon / Supabase / any standard Postgres works)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Password used to sign in to /admin
ADMIN_PASSWORD=change-me

# Long random string used to sign admin session cookies — generate with:
# openssl rand -base64 32
SESSION_SECRET=change-me-too
